# Application
# APP_NAME=UFO
# APP_ENV=local
# APP_KEY=
# APP_DEBUG=true
# APP_URL=http://localhost

# Localization
# APP_LOCALE=en
# APP_FALLBACK_LOCALE=en
# APP_FAKER_LOCALE=en_US

# Maintenance
# APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

# Security
# BCRYPT_ROUNDS=12

# Logging
# LOG_CHANNEL=stack
# LOG_STACK=single
# LOG_DEPRECATIONS_CHANNEL=null
# LOG_LEVEL=debug

# Database
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Session
# SESSION_DRIVER=file
# SESSION_LIFETIME=120
# SESSION_ENCRYPT=false
# SESSION_PATH=/
# SESSION_DOMAIN=null

# Services
# BROADCAST_CONNECTION=log
# FILESYSTEM_DISK=local
# QUEUE_CONNECTION=database

# Cache
# CACHE_STORE=file
# CACHE_PREFIX=
# MEMCACHED_HOST=127.0.0.1

# Redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Mail
# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend
# VITE_APP_NAME="${APP_NAME}"

# Deploy bootstrap (runtime only)
# UFO_DB_NAME=ufo_db
# UFO_DB_USER=ufo_user
# UFO_DB_PASSWORD=
# MYSQL_ROOT_HOST=127.0.0.1
# MYSQL_ROOT_PORT=3306
# MYSQL_ROOT_USER=root
# MYSQL_ROOT_PASSWORD=

# Security mode
# AUTH_DEMO_MODE=false
# AUTH_DEMO_KEMAHASISWAAN_NAME=
# AUTH_DEMO_KEMAHASISWAAN_EMAIL=
# AUTH_DEMO_KEMAHASISWAAN_PASSWORD_HASH=
# AUTH_DEMO_PENGURUS_NAME=
# AUTH_DEMO_PENGURUS_EMAIL=
# AUTH_DEMO_PENGURUS_PASSWORD_HASH=
# AUTH_DEMO_PENGURUS_STATUS=
# AUTH_DEFAULT_UKM_PASSWORD=
# USER_FACTORY_PASSWORD=
