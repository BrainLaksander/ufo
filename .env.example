# Application
APP_NAME=UFO
APP_ENV=development
APP_KEY=base64:iZa6VNHuH/ksoDvEAP0AxwpKiZe4aNvzIvi1CaMpNqE=
APP_DEBUG=false
APP_URL=http://localhost/ufo

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ufo
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Services
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=file
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@uforum.online
MAIL_FROM_NAME="UForum"

# Announcement distribution targets
# Use mailing list addresses or comma-separated recipients.
ANNOUNCEMENT_MAILING_STUDENTS=
ANNOUNCEMENT_MAILING_SELECTED=
ANNOUNCEMENT_MAILING_DEFAULT=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Auth runtime (use database accounts)
AUTH_DEMO_MODE=false
AUTH_DEMO_KEMAHASISWAAN_EMAIL=
AUTH_DEMO_KEMAHASISWAAN_PASSWORD_HASH=
AUTH_DEMO_PENGURUS_EMAIL=
AUTH_DEMO_PENGURUS_PASSWORD_HASH=

# Optional local-only utility password seeds (leave empty in production)
AUTH_DEFAULT_UKM_PASSWORD=
USER_FACTORY_PASSWORD=
